<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- The three roles of the other NewErp versions. In Odoo 19 groups belong to a "privilege": the user form shows
         one choice per privilege, so a user gets one role, and each role implies the standard groups it needs. -->
    <record id="privilege_newerp" model="res.groups.privilege">
        <field name="name">NewErp</field>
        <field name="sequence">1</field>
        <field name="description">Роль у NewErp: менеджер, комірник чи адміністратор.</field>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Менеджер</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_newerp" />
        <field name="comment">Замовлення й клієнти, рахунки й оплати.</field>
        <field
            name="implied_ids"
            eval="[(4, ref('sales_team.group_sale_salesman_all_leads')), (4, ref('account.group_account_invoice')), (4, ref('base.group_partner_manager'))]"
        />
    </record>

    <record id="group_storekeeper" model="res.groups">
        <field name="name">Комірник</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_newerp" />
        <field name="comment">Склад, виробництво й закупівлі.</field>
        <field
            name="implied_ids"
            eval="[(4, ref('stock.group_stock_user')), (4, ref('mrp.group_mrp_user')), (4, ref('purchase.group_purchase_user'))]"
        />
    </record>

    <record id="group_admin" model="res.groups">
        <field name="name">Адміністратор</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_newerp" />
        <field name="comment">Усе: обидві ролі, керівники застосунків і налаштування.</field>
        <field
            name="implied_ids"
            eval="[(4, ref('group_manager')), (4, ref('group_storekeeper')), (4, ref('sales_team.group_sale_manager')), (4, ref('stock.group_stock_manager')), (4, ref('mrp.group_mrp_manager')), (4, ref('purchase.group_purchase_manager')), (4, ref('base.group_system'))]"
        />
    </record>
</odoo>
