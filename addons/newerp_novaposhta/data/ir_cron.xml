<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Weekly: Nova Poshta opens and closes branches often. Quiet while no carrier has a key. -->
    <record id="cron_update_warehouses" model="ir.cron">
        <field name="name">Нова Пошта: довідник відділень</field>
        <field name="model_id" ref="delivery.model_delivery_carrier" />
        <field name="state">code</field>
        <field name="code">model._cron_np_update_warehouses()</field>
        <field name="interval_number">7</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
