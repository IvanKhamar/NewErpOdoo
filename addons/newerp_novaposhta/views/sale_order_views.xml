<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.newerp_novaposhta</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <field name="np_warehouse_kind" invisible="1" />
                <field
                    name="np_warehouse_id"
                    invisible="np_warehouse_kind not in ('branch', 'locker')"
                    options="{'no_create': True}"
                    readonly="state in ('cancel', 'sale')"
                />
                <field
                    name="np_city_id"
                    invisible="np_warehouse_kind != 'door'"
                    options="{'no_create': True}"
                    readonly="state in ('cancel', 'sale')"
                />
                <field name="np_street" invisible="np_warehouse_kind != 'door'" readonly="state in ('cancel', 'sale')" />
                <field name="np_building" invisible="np_warehouse_kind != 'door'" readonly="state in ('cancel', 'sale')" />
                <field name="np_flat" invisible="np_warehouse_kind != 'door'" readonly="state in ('cancel', 'sale')" />
            </xpath>
        </field>
    </record>
</odoo>
