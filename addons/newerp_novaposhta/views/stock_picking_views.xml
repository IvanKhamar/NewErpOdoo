<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.newerp_novaposhta</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock_delivery.view_picking_withcarrier_out_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='carrier_id']" position="after">
                <field name="np_warehouse_id" invisible="not np_warehouse_id" />
                <field name="np_status" invisible="not np_status" />
                <field name="np_date_scheduled" invisible="not np_date_scheduled" />
                <field name="np_date_payed_keeping" invisible="not np_date_payed_keeping" />
            </xpath>
        </field>
    </record>
</odoo>
