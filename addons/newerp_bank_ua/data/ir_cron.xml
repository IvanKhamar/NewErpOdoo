<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Off until a bank journal has its keys: an admin turns it on in Settings → Technical → Scheduled Actions. -->
    <record id="cron_import" model="ir.cron">
        <field name="name">Банк: виписка й підбір замовлень</field>
        <field name="model_id" ref="model_newerp_bank_import" />
        <field name="state">code</field>
        <field name="code">model._cron_import()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="False" />
    </record>
</odoo>
