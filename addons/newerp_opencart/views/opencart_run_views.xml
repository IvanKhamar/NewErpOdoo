<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="opencart_run_view_list" model="ir.ui.view">
        <field name="name">newerp.opencart.run.list</field>
        <field name="model">newerp.opencart.run</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" decoration-danger="state == 'failed'">
                <field name="create_date" string="Коли" />
                <field name="kind" string="Що" />
                <field name="state" string="Стан" />
                <field name="created" string="Нових" />
                <field name="updated" string="Оновлених" />
                <field name="message" string="Повідомлення" />
            </list>
        </field>
    </record>

    <record id="opencart_run_action" model="ir.actions.act_window">
        <field name="name">OpenCart: запуски</field>
        <field name="res_model">newerp.opencart.run</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem
        id="opencart_run_menu"
        name="OpenCart: запуски"
        parent="sale.menu_sale_config"
        action="opencart_run_action"
        groups="newerp_base.group_admin"
        sequence="90"
    />
</odoo>
