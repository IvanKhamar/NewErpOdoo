<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.newerp_opencart</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="OpenCart" string="OpenCart" name="newerp_opencart" groups="newerp_base.group_admin">
                    <block title="База даних магазину" name="newerp_opencart_connection">
                        <setting
                            id="newerp_opencart_connection"
                            string="MySQL OpenCart"
                            help="Звідки брати товари, клієнтів і замовлення і куди писати залишки."
                        >
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="newerp_opencart_host" class="col-lg-4 o_light_label" />
                                    <field name="newerp_opencart_host" placeholder="host.docker.internal" />
                                </div>
                                <div class="row mt8">
                                    <label for="newerp_opencart_port" class="col-lg-4 o_light_label" />
                                    <field name="newerp_opencart_port" />
                                </div>
                                <div class="row mt8">
                                    <label for="newerp_opencart_database" class="col-lg-4 o_light_label" />
                                    <field name="newerp_opencart_database" />
                                </div>
                                <div class="row mt8">
                                    <label for="newerp_opencart_user" class="col-lg-4 o_light_label" />
                                    <field name="newerp_opencart_user" />
                                </div>
                                <div class="row mt8">
                                    <label for="newerp_opencart_password" class="col-lg-4 o_light_label" />
                                    <field name="newerp_opencart_password" password="True" />
                                </div>
                                <div class="row mt8">
                                    <label for="newerp_opencart_prefix" class="col-lg-4 o_light_label" />
                                    <field name="newerp_opencart_prefix" />
                                </div>
                                <div class="row mt8">
                                    <label for="newerp_opencart_language_id" class="col-lg-4 o_light_label" />
                                    <field name="newerp_opencart_language_id" />
                                </div>
                                <div class="mt16">
                                    <button
                                        name="action_newerp_opencart_check"
                                        type="object"
                                        string="Перевірити з'єднання"
                                        class="btn-secondary"
                                    />
                                    <button
                                        name="action_newerp_opencart_import_catalog"
                                        type="object"
                                        string="Імпортувати товари"
                                        class="btn-secondary ms-2"
                                    />
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
